<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld кадр</string>
			<key>few</key>
			<string>%lld кадра</string>
			<key>many</key>
			<string>%lld кадров</string>
			<key>other</key>
			<string>%lld кадра</string>
		</dict>
	</dict>
	<key>%lld years ago</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld год назад</string>
			<key>few</key>
			<string>%lld года назад</string>
			<key>many</key>
			<string>%lld лет назад</string>
			<key>other</key>
			<string>%lld года назад</string>
		</dict>
	</dict>
	<key>To the Trash: %lld copies from the archive, %@. iCloud Drive files go to Recently Deleted in iCloud Drive, where they can be restored.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>В Корзину: %1$#@n@ из архива, %2$@. Файлы iCloud Drive попадают в «Недавно удалённые» iCloud Drive, оттуда их можно вернуть.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld копия</string>
			<key>few</key>
			<string>%1$lld копии</string>
			<key>many</key>
			<string>%1$lld копий</string>
			<key>other</key>
			<string>%1$lld копии</string>
		</dict>
	</dict>
	<key>Staying in Photos: %lld originals, %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Остаются в «Фото»: %1$#@n@, %2$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld оригинал</string>
			<key>few</key>
			<string>%1$lld оригинала</string>
			<key>many</key>
			<string>%1$lld оригиналов</string>
			<key>other</key>
			<string>%1$lld оригинала</string>
		</dict>
	</dict>
	<key>From Photos to Recently Deleted: %lld items, %@. Photos will show its own confirmation window; for 30 days the items can be restored from Recently Deleted.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Из «Фото» в «Недавно удалённые»: %1$#@n@, %2$@. «Фото» покажут своё окно подтверждения; 30 дней кадры можно вернуть из «Недавно удалённых».</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
